  "mailer_subjects_recovery": "BabySteps",
  "mailer_templates_recovery_content": "{{ if eq .RedirectTo \"https://mabatista2010.github.io/babysteps-legal/reset-password.html?lang=fr\" }}<!doctype html>\n<html lang=\"fr\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Retrouve l’accès à BabySteps</title></head>\n<body bgcolor=\"#fbf9f4\" style=\"margin:0;padding:0;background-color:#fbf9f4;color:#4a352e;font-family:'Nunito Sans',Arial,sans-serif;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%\">\n<div aria-hidden=\"true\" style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all\">Choisis un nouveau mot de passe</div>\n<table role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" bgcolor=\"#fbf9f4\" style=\"width:100%;border-collapse:collapse;background-color:#fbf9f4\">\n<tr><td align=\"center\" style=\"padding:24px 16px\">\n<table role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"width:100%;max-width:560px;border-collapse:collapse\">\n<tr><td style=\"padding:16px 24px 32px;color:#4a352e;font-family:'Nunito Sans',Arial,sans-serif;word-wrap:break-word;overflow-wrap:break-word\">\n<p style=\"margin:0 0 12px;font-size:24px;line-height:32px;font-weight:800;letter-spacing:-0.6px;color:#4a352e\">BabySteps</p>\n<table role=\"presentation\" width=\"40\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" aria-hidden=\"true\" style=\"width:40px;border-collapse:collapse\"><tr><td height=\"4\" bgcolor=\"#ef8068\" style=\"height:4px;font-size:0;line-height:0;background-color:#ef8068\">&nbsp;</td></tr></table>\n<h1 style=\"margin:32px 0 16px;font-size:30px;line-height:36px;font-weight:800;letter-spacing:-0.6px;color:#4a352e;word-wrap:break-word\">Choisis un nouveau mot de passe</h1>\n<p style=\"margin:0 0 24px;font-size:16px;line-height:26px;color:#6f5d55\">Nous avons reçu une demande de réinitialisation du mot de passe de ton compte BabySteps. Utilise ce lien pour choisir un nouveau mot de passe.</p>\n<table role=\"presentation\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"border-collapse:separate;max-width:100%;margin:0 0 28px\"><tr><td bgcolor=\"#ef8068\" style=\"border-radius:12px;background-color:#ef8068\">\n<a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;border:14px solid #ef8068;border-left-width:24px;border-right-width:24px;border-radius:12px;background-color:#ef8068;color:#2b2926;font-family:'Nunito Sans',Arial,sans-serif;font-size:16px;line-height:24px;font-weight:800;text-align:center;text-decoration:none;word-wrap:break-word\">Réinitialiser le mot de passe</a>\n</td></tr></table>\n<p style=\"margin:0 0 16px;font-size:15px;line-height:24px;color:#6f5d55\">Ce lien est personnel et expire. Ne le partage pas. BabySteps s’ouvrira si l’application est installée, sinon tu pourras continuer sur la page web.</p>\n<p style=\"margin:0 0 28px;font-size:15px;line-height:24px;color:#6f5d55\">Si tu n’as pas demandé ce changement, tu peux ignorer cet e-mail. Le simple fait de le recevoir ne modifie pas ton mot de passe.</p>\n<table role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"width:100%;border-collapse:collapse\"><tr><td style=\"border-top:1px solid #e6ded1;padding-top:24px;color:#4a352e;font-family:'Nunito Sans',Arial,sans-serif\">\n<p style=\"margin:0 0 4px;font-size:15px;line-height:24px;font-weight:700\">Besoin d’aide ?</p>\n<p style=\"margin:0;font-size:15px;line-height:24px\"><a href=\"mailto:support@babysteps.space\" style=\"color:#4a352e;text-decoration:underline;text-underline-offset:3px\">support@babysteps.space</a></p>\n</td></tr></table>\n</td></tr></table>\n</td></tr></table>\n</body></html>{{ else if eq .RedirectTo \"https://mabatista2010.github.io/babysteps-legal/reset-password.html?lang=en\" }}<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Recover access to BabySteps</title></head>\n<body bgcolor=\"#fbf9f4\" style=\"margin:0;padding:0;background-color:#fbf9f4;color:#4a352e;font-family:'Nunito Sans',Arial,sans-serif;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%\">\n<div aria-hidden=\"true\" style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all\">Create a new password</div>\n<table role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" bgcolor=\"#fbf9f4\" style=\"width:100%;border-collapse:collapse;background-color:#fbf9f4\">\n<tr><td align=\"center\" style=\"padding:24px 16px\">\n<table role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"width:100%;max-width:560px;border-collapse:collapse\">\n<tr><td style=\"padding:16px 24px 32px;color:#4a352e;font-family:'Nunito Sans',Arial,sans-serif;word-wrap:break-word;overflow-wrap:break-word\">\n<p style=\"margin:0 0 12px;font-size:24px;line-height:32px;font-weight:800;letter-spacing:-0.6px;color:#4a352e\">BabySteps</p>\n<table role=\"presentation\" width=\"40\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" aria-hidden=\"true\" style=\"width:40px;border-collapse:collapse\"><tr><td height=\"4\" bgcolor=\"#ef8068\" style=\"height:4px;font-size:0;line-height:0;background-color:#ef8068\">&nbsp;</td></tr></table>\n<h1 style=\"margin:32px 0 16px;font-size:30px;line-height:36px;font-weight:800;letter-spacing:-0.6px;color:#4a352e;word-wrap:break-word\">Create a new password</h1>\n<p style=\"margin:0 0 24px;font-size:16px;line-height:26px;color:#6f5d55\">We received a request to reset your BabySteps account password. Use this link to choose a new password.</p>\n<table role=\"presentation\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"border-collapse:separate;max-width:100%;margin:0 0 28px\"><tr><td bgcolor=\"#ef8068\" style=\"border-radius:12px;background-color:#ef8068\">\n<a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;border:14px solid #ef8068;border-left-width:24px;border-right-width:24px;border-radius:12px;background-color:#ef8068;color:#2b2926;font-family:'Nunito Sans',Arial,sans-serif;font-size:16px;line-height:24px;font-weight:800;text-align:center;text-decoration:none;word-wrap:break-word\">Reset password</a>\n</td></tr></table>\n<p style=\"margin:0 0 16px;font-size:15px;line-height:24px;color:#6f5d55\">This link is personal and will expire. Don’t share it. BabySteps will open if the app is installed, or you can continue on the web page.</p>\n<p style=\"margin:0 0 28px;font-size:15px;line-height:24px;color:#6f5d55\">If you didn’t request this change, you can ignore this email. Receiving it won’t change your password.</p>\n<table role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"width:100%;border-collapse:collapse\"><tr><td style=\"border-top:1px solid #e6ded1;padding-top:24px;color:#4a352e;font-family:'Nunito Sans',Arial,sans-serif\">\n<p style=\"margin:0 0 4px;font-size:15px;line-height:24px;font-weight:700\">Need help?</p>\n<p style=\"margin:0;font-size:15px;line-height:24px\"><a href=\"mailto:support@babysteps.space\" style=\"color:#4a352e;text-decoration:underline;text-underline-offset:3px\">support@babysteps.space</a></p>\n</td></tr></table>\n</td></tr></table>\n</td></tr></table>\n</body></html>{{ else if eq .RedirectTo \"https://mabatista2010.github.io/babysteps-legal/reset-password.html?lang=pt-PT\" }}<!doctype html>\n<html lang=\"pt-PT\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Recupera o acesso ao BabySteps</title></head>\n<body bgcolor=\"#fbf9f4\" style=\"margin:0;padding:0;background-color:#fbf9f4;color:#4a352e;font-family:'Nunito Sans',Arial,sans-serif;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%\">\n<div aria-hidden=\"true\" style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all\">Cria uma nova palavra-passe</div>\n<table role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" bgcolor=\"#fbf9f4\" style=\"width:100%;border-collapse:collapse;background-color:#fbf9f4\">\n<tr><td align=\"center\" style=\"padding:24px 16px\">\n<table role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"width:100%;max-width:560px;border-collapse:collapse\">\n<tr><td style=\"padding:16px 24px 32px;color:#4a352e;font-family:'Nunito Sans',Arial,sans-serif;word-wrap:break-word;overflow-wrap:break-word\">\n<p style=\"margin:0 0 12px;font-size:24px;line-height:32px;font-weight:800;letter-spacing:-0.6px;color:#4a352e\">BabySteps</p>\n<table role=\"presentation\" width=\"40\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" aria-hidden=\"true\" style=\"width:40px;border-collapse:collapse\"><tr><td height=\"4\" bgcolor=\"#ef8068\" style=\"height:4px;font-size:0;line-height:0;background-color:#ef8068\">&nbsp;</td></tr></table>\n<h1 style=\"margin:32px 0 16px;font-size:30px;line-height:36px;font-weight:800;letter-spacing:-0.6px;color:#4a352e;word-wrap:break-word\">Cria uma nova palavra-passe</h1>\n<p style=\"margin:0 0 24px;font-size:16px;line-height:26px;color:#6f5d55\">Recebemos um pedido para repor a palavra-passe da tua conta BabySteps. Usa esta ligação para escolheres uma nova palavra-passe.</p>\n<table role=\"presentation\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"border-collapse:separate;max-width:100%;margin:0 0 28px\"><tr><td bgcolor=\"#ef8068\" style=\"border-radius:12px;background-color:#ef8068\">\n<a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;border:14px solid #ef8068;border-left-width:24px;border-right-width:24px;border-radius:12px;background-color:#ef8068;color:#2b2926;font-family:'Nunito Sans',Arial,sans-serif;font-size:16px;line-height:24px;font-weight:800;text-align:center;text-decoration:none;word-wrap:break-word\">Repor a palavra-passe</a>\n</td></tr></table>\n<p style=\"margin:0 0 16px;font-size:15px;line-height:24px;color:#6f5d55\">Esta ligação é pessoal e tem validade limitada. Não a partilhes. O BabySteps será aberto se a aplicação estiver instalada, ou poderás continuar na página web.</p>\n<p style=\"margin:0 0 28px;font-size:15px;line-height:24px;color:#6f5d55\">Se não pediste esta alteração, podes ignorar este e-mail. A tua palavra-passe não será alterada pelo simples facto de o receberes.</p>\n<table role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"width:100%;border-collapse:collapse\"><tr><td style=\"border-top:1px solid #e6ded1;padding-top:24px;color:#4a352e;font-family:'Nunito Sans',Arial,sans-serif\">\n<p style=\"margin:0 0 4px;font-size:15px;line-height:24px;font-weight:700\">Precisas de ajuda?</p>\n<p style=\"margin:0;font-size:15px;line-height:24px\"><a href=\"mailto:support@babysteps.space\" style=\"color:#4a352e;text-decoration:underline;text-underline-offset:3px\">support@babysteps.space</a></p>\n</td></tr></table>\n</td></tr></table>\n</td></tr></table>\n</body></html>{{ else if eq .RedirectTo \"https://mabatista2010.github.io/babysteps-legal/reset-password.html?lang=it\" }}<!doctype html>\n<html lang=\"it\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Recupera l’accesso a BabySteps</title></head>\n<body bgcolor=\"#fbf9f4\" style=\"margin:0;padding:0;background-color:#fbf9f4;color:#4a352e;font-family:'Nunito Sans',Arial,sans-serif;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%\">\n<div aria-hidden=\"true\" style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all\">Crea una nuova password</div>\n<table role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" bgcolor=\"#fbf9f4\" style=\"width:100%;border-collapse:collapse;background-color:#fbf9f4\">\n<tr><td align=\"center\" style=\"padding:24px 16px\">\n<table role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"width:100%;max-width:560px;border-collapse:collapse\">\n<tr><td style=\"padding:16px 24px 32px;color:#4a352e;font-family:'Nunito Sans',Arial,sans-serif;word-wrap:break-word;overflow-wrap:break-word\">\n<p style=\"margin:0 0 12px;font-size:24px;line-height:32px;font-weight:800;letter-spacing:-0.6px;color:#4a352e\">BabySteps</p>\n<table role=\"presentation\" width=\"40\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" aria-hidden=\"true\" style=\"width:40px;border-collapse:collapse\"><tr><td height=\"4\" bgcolor=\"#ef8068\" style=\"height:4px;font-size:0;line-height:0;background-color:#ef8068\">&nbsp;</td></tr></table>\n<h1 style=\"margin:32px 0 16px;font-size:30px;line-height:36px;font-weight:800;letter-spacing:-0.6px;color:#4a352e;word-wrap:break-word\">Crea una nuova password</h1>\n<p style=\"margin:0 0 24px;font-size:16px;line-height:26px;color:#6f5d55\">Abbiamo ricevuto una richiesta per reimpostare la password del tuo account BabySteps. Usa questo link per scegliere una nuova password.</p>\n<table role=\"presentation\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"border-collapse:separate;max-width:100%;margin:0 0 28px\"><tr><td bgcolor=\"#ef8068\" style=\"border-radius:12px;background-color:#ef8068\">\n<a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;border:14px solid #ef8068;border-left-width:24px;border-right-width:24px;border-radius:12px;background-color:#ef8068;color:#2b2926;font-family:'Nunito Sans',Arial,sans-serif;font-size:16px;line-height:24px;font-weight:800;text-align:center;text-decoration:none;word-wrap:break-word\">Reimposta la password</a>\n</td></tr></table>\n<p style=\"margin:0 0 16px;font-size:15px;line-height:24px;color:#6f5d55\">Questo link è personale e ha una scadenza. Non condividerlo. Si aprirà BabySteps se l’app è installata, oppure potrai continuare sulla pagina web.</p>\n<p style=\"margin:0 0 28px;font-size:15px;line-height:24px;color:#6f5d55\">Se non hai richiesto questa modifica, puoi ignorare questa e-mail. Riceverla non cambia la tua password.</p>\n<table role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"width:100%;border-collapse:collapse\"><tr><td style=\"border-top:1px solid #e6ded1;padding-top:24px;color:#4a352e;font-family:'Nunito Sans',Arial,sans-serif\">\n<p style=\"margin:0 0 4px;font-size:15px;line-height:24px;font-weight:700\">Hai bisogno di aiuto?</p>\n<p style=\"margin:0;font-size:15px;line-height:24px\"><a href=\"mailto:support@babysteps.space\" style=\"color:#4a352e;text-decoration:underline;text-underline-offset:3px\">support@babysteps.space</a></p>\n</td></tr></table>\n</td></tr></table>\n</td></tr></table>\n</body></html>{{ else }}<!doctype html>\n<html lang=\"es\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Recupera el acceso a BabySteps</title></head>\n<body bgcolor=\"#fbf9f4\" style=\"margin:0;padding:0;background-color:#fbf9f4;color:#4a352e;font-family:'Nunito Sans',Arial,sans-serif;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%\">\n<div aria-hidden=\"true\" style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all\">Crea una nueva contraseña</div>\n<table role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" bgcolor=\"#fbf9f4\" style=\"width:100%;border-collapse:collapse;background-color:#fbf9f4\">\n<tr><td align=\"center\" style=\"padding:24px 16px\">\n<table role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"width:100%;max-width:560px;border-collapse:collapse\">\n<tr><td style=\"padding:16px 24px 32px;color:#4a352e;font-family:'Nunito Sans',Arial,sans-serif;word-wrap:break-word;overflow-wrap:break-word\">\n<p style=\"margin:0 0 12px;font-size:24px;line-height:32px;font-weight:800;letter-spacing:-0.6px;color:#4a352e\">BabySteps</p>\n<table role=\"presentation\" width=\"40\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" aria-hidden=\"true\" style=\"width:40px;border-collapse:collapse\"><tr><td height=\"4\" bgcolor=\"#ef8068\" style=\"height:4px;font-size:0;line-height:0;background-color:#ef8068\">&nbsp;</td></tr></table>\n<h1 style=\"margin:32px 0 16px;font-size:30px;line-height:36px;font-weight:800;letter-spacing:-0.6px;color:#4a352e;word-wrap:break-word\">Crea una nueva contraseña</h1>\n<p style=\"margin:0 0 24px;font-size:16px;line-height:26px;color:#6f5d55\">Hemos recibido una solicitud para restablecer la contraseña de tu cuenta BabySteps. Usa este enlace para elegir una nueva contraseña.</p>\n<table role=\"presentation\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"border-collapse:separate;max-width:100%;margin:0 0 28px\"><tr><td bgcolor=\"#ef8068\" style=\"border-radius:12px;background-color:#ef8068\">\n<a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;border:14px solid #ef8068;border-left-width:24px;border-right-width:24px;border-radius:12px;background-color:#ef8068;color:#2b2926;font-family:'Nunito Sans',Arial,sans-serif;font-size:16px;line-height:24px;font-weight:800;text-align:center;text-decoration:none;word-wrap:break-word\">Restablecer contraseña</a>\n</td></tr></table>\n<p style=\"margin:0 0 16px;font-size:15px;line-height:24px;color:#6f5d55\">El enlace es personal y caduca. No lo compartas. Se abrirá BabySteps si está instalada o podrás continuar en la página web.</p>\n<p style=\"margin:0 0 28px;font-size:15px;line-height:24px;color:#6f5d55\">Si no has solicitado este cambio, puedes ignorar este correo. Tu contraseña no cambiará por recibirlo.</p>\n<table role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"width:100%;border-collapse:collapse\"><tr><td style=\"border-top:1px solid #e6ded1;padding-top:24px;color:#4a352e;font-family:'Nunito Sans',Arial,sans-serif\">\n<p style=\"margin:0 0 4px;font-size:15px;line-height:24px;font-weight:700\">¿Necesitas ayuda?</p>\n<p style=\"margin:0;font-size:15px;line-height:24px\"><a href=\"mailto:support@babysteps.space\" style=\"color:#4a352e;text-decoration:underline;text-underline-offset:3px\">support@babysteps.space</a></p>\n</td></tr></table>\n</td></tr></table>\n</td></tr></table>\n</body></html>{{ end }}\n"
